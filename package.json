{
  "name": "agingdeveloper",
  "private": true,
  "description": "The personal site of Richard Klein",
  "version": "6.12.0",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "clean": "rm -rf .astro dist node_modules",
    "upgrade:astro": "npx @astrojs/upgrade",
    "upgrade:tailwind": "npx @tailwindcss/upgrade",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "netlify dev",
    "preview:build": "pnpm run build && netlify dev",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,astro}\"",
    "lint:fix": "eslint --fix \"**/*.{js,mjs,cjs,ts,astro}\"",
    "format": "prettier --check \"**/*.{js,mjs,cjs,ts,astro,md,mdx}\"",
    "format:fix": "prettier --write \"**/*.{js,mjs,cjs,ts,astro,md,mdx}\"",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run lint && pnpm run format && pnpm run test && pnpm run build",
    "licenses": "license-report --output=table",
    "licenses:html": "license-report --output=html > license-report.html"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/netlify": "^8.1.3",
    "@astrojs/sitemap": "^3.7.3",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/noto-sans-georgian": "^5.3.0",
    "@fontsource/noto-serif-georgian": "^5.3.0",
    "@fontsource/walter-turncoat": "^5.3.0",
    "@iconify-json/mdi": "^1.1.66",
    "@lhci/cli": "^0.15.1",
    "@sindresorhus/slugify": "^3.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/sanitize-html": "^2.11.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.3",
    "@vitest/eslint-plugin": "^1.6.12",
    "astro": "^7.1.6",
    "astro-icon": "^1.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "feed": "^5.0.0",
    "fuse.js": "^7.5.0",
    "license-report": "^6.7.1",
    "markdown-it": "^14.3.0",
    "mdast-util-to-string": "^4.0.0",
    "mime": "^4.0.4",
    "netlify-cli": "^26.2.0",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "reading-time": "^1.5.0",
    "sanitize-html": "^2.17.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.3"
  }
}
