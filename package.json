{
  "name": "agingdeveloper",
  "private": true,
  "description": "The personal site of Richard Klein",
  "version": "6.15.5",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "clean": "rm -rf .astro dist node_modules",
    "upgrade:astro": "npx @astrojs/upgrade",
    "upgrade:tailwind": "npx @tailwindcss/upgrade",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "netlify dev",
    "preview:build": "pnpm run build && netlify dev",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,astro}\"",
    "lint:fix": "eslint --fix \"**/*.{js,mjs,cjs,ts,astro}\"",
    "format": "prettier --check \"**/*.{js,mjs,cjs,ts,astro,md,mdx}\"",
    "format:fix": "prettier --write \"**/*.{js,mjs,cjs,ts,astro,md,mdx}\"",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run lint && pnpm run format && pnpm run test && pnpm run build",
    "licenses": "license-report --output=table",
    "licenses:html": "license-report --output=html > license-report.html"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/netlify": "^8.2.14",
    "@astrojs/sitemap": "^3.7.5",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/noto-sans-georgian": "^5.3.0",
    "@fontsource/noto-serif-georgian": "^5.3.0",
    "@fontsource/walter-turncoat": "^5.3.0",
    "@iconify-json/bi": "^1.2.7",
    "@lhci/cli": "^0.16.1",
    "@sindresorhus/slugify": "^3.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/markdown-it": "^14.2.0",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "astro": "^7.4.13",
    "astro-icon": "^1.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "feed": "^6.0.0",
    "fuse.js": "^7.5.0",
    "license-report": "^6.8.6",
    "markdown-it": "^15.0.3",
    "mdast-util-to-string": "^4.0.0",
    "mime": "^4.1.2",
    "netlify-cli": "^27.19.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "reading-time": "^1.5.0",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
